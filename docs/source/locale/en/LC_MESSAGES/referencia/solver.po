msgid "Clases de resultado"
msgstr "Result classes"

#: of walopy.solver.SolverResult:1
msgid "Resultado de resolver un parámetro para alcanzar una meta."
msgstr "Result of solving a parameter to reach a goal."

#: ../../source/referencia/solver.rst
msgid "Variables"
msgstr "Variables"

#: of walopy.solver.SolverResult:3
msgid "Nombre del parámetro resuelto."
msgstr "Name of the solved parameter."

#: of walopy.solver.SolverResult:5
msgid "Valor del parámetro encontrado."
msgstr "Value of the parameter found."

#: of walopy.solver.SolverResult:7
msgid "Métrica que se restringió."
msgstr "Metric that was constrained."

#: of walopy.solver.SolverResult:9
msgid "Valor deseado de la métrica."
msgstr "Desired value of the metric."

#: of walopy.solver.SolverResult:11
msgid "Valor real de la métrica en la solución."
msgstr "Actual value of the metric at the solution."

#: of walopy.solver.SolverResult:13
msgid "Resultado completo del modelo en el punto solución."
msgstr "Complete model result at the solution point."

#: of walopy.solver.OptimizeResult:1
msgid "Resultado de minimizar el costo según el número de servidores."
msgstr "Result of minimizing the cost by number of servers."

#: of walopy.solver.OptimizeResult:3
msgid "Número de servidores que minimiza el costo total."
msgstr "Number of servers that minimizes the total cost."

#: of walopy.solver.OptimizeResult:5
msgid "Costo total mínimo por unidad de tiempo."
msgstr "Minimum total cost per unit of time."

#: of walopy.solver.OptimizeResult:7
msgid "Componentes del costo para cada c evaluado."
msgstr "Cost components for each c evaluated."

#: of walopy.solver.OptimizeResult:9
msgid "Resultado completo de colas en el c óptimo."
msgstr "Complete queueing result at the optimal c."

