msgstr "((b − a) / 6)² — PERT only."

#: of walopy.project.ProjectResult:1
msgid "Resultado de la programación de un proyecto con CPM / PERT."
msgstr "Result of scheduling a project with CPM / PERT."

#: of walopy.project.ProjectResult:5
msgid "Nombres de las actividades de la ruta crítica en orden topológico."
msgstr "Names of the critical-path activities in topological order."

#: of walopy.project.ProjectResult:7
