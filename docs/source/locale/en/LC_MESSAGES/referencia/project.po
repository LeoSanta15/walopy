#: of walopy.project.ActivityResult:11
msgid "Fin más temprano."
msgstr "Earliest finish."

#: of walopy.project.ActivityResult:13
msgid "Inicio más tardío."
msgstr "Latest start."

#: of walopy.project.ActivityResult:15
msgid "Fin más tardío."
msgstr "Latest finish."

#: of walopy.project.ActivityResult:17
msgid "Holgura total = LS − ES."
msgstr "Total float = LS − ES."

#: of walopy.project.ActivityResult:19
