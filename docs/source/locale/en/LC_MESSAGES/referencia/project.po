msgstr "√(project_variance) (PERT only)."

#: of walopy.project.ProjectResult.probability_mc:1
msgid "P(duración del proyecto ≤ objetivo) estimada por simulación (requiere ``pert(..., n_simulations=N)``)."
msgstr "P(project duration ≤ target) estimated by simulation (requires ``pert(..., n_simulations=N)``)."

#: of walopy.project.ProjectResult.probability_mc:3
msgid "A diferencia de ``probability`` (normal sobre una sola ruta), considera todas las rutas: con varias rutas casi críticas es bastante menor."
msgstr "Unlike ``probability`` (normal over a single path), it considers all paths: with several near-critical paths it is considerably lower."

#: of walopy.project.ProjectResult.probability:3
#: walopy.project.ProjectResult.probability_mc:6
msgid "Tiempo objetivo T de terminación del proyecto."
msgstr "Target project completion time T."

#: of walopy.project.ProjectResult.percentile_mc:1
msgid "Percentil *q* (0 a 100) de la duración simulada del proyecto (requiere ``pert(..., n_simulations=N)``)."
msgstr "Percentile *q* (0 to 100) of the simulated project duration (requires ``pert(..., n_simulations=N)``)."

#: of walopy.project.ProjectResult.percentile_mc:3
msgid "Percentil entre 0 y 100."
msgstr "Percentile between 0 and 100."

#: of walopy.project.ProjectResult.probability:1
msgid "P(duración del proyecto ≤ objetivo) mediante aproximación normal (solo PERT)."
msgstr "P(project duration ≤ target) using a normal approximation (PERT only)."

