msgid "Clases de resultado"
msgstr "Result classes"

#: of walopy.network.StationMetrics:1
msgid "Métricas por estación en una red de Jackson."
msgstr "Per-station metrics in a Jackson network."

#: ../../source/referencia/network.rst
msgid "Variables"
msgstr "Variables"

#: of walopy.network.StationMetrics:5
msgid "Tasa total de llegadas (externas + ruteadas desde otras estaciones)."
msgstr "Total arrival rate (external + routed from other stations)."

#: of walopy.network.StationMetrics:7
msgid "Tasa de llegadas externas (Poisson)."
msgstr "External (Poisson) arrival rate."

#: of walopy.network.StationMetrics:9
msgid "Tasa de servicio por servidor."
msgstr "Service rate per server."

#: of walopy.network.StationMetrics:11
msgid "Número de servidores."
msgstr "Number of servers."

#: of walopy.network.StationMetrics:13
msgid "Utilización = lam_total / (servidores × mu)."
msgstr "Utilization = lam_total / (servers × mu)."

#: of walopy.network.StationMetrics:15
msgid "Métricas M/M/c estándar."
msgstr "Standard M/M/c metrics."

#: of walopy.network.JacksonResult:1
msgid "Resultado del análisis de una red abierta de Jackson."
msgstr "Result of the analysis of an open Jackson network."

#: of walopy.network.JacksonResult:3
msgid "Métricas por estación."
msgstr "Per-station metrics."

#: of walopy.network.JacksonResult:5
msgid "Total esperado de clientes en todas las estaciones (suma de L_j)."
msgstr "Expected total number of customers in all the stations (sum of L_j)."

#: of walopy.network.JacksonResult:7
msgid "Tiempo medio de permanencia en la red = L_system / tasa total de llegadas externas."
msgstr "Mean time in the network = L_system / total external arrival rate."

